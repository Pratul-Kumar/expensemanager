rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Notes: users can only read/write their own
    match /notes/{noteId} {
      allow read, update, delete: if
        request.auth != null &&
        resource.data.userId == request.auth.uid;

      allow create: if
        request.auth != null &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.title is string &&
        request.resource.data.content is string;
    }

    // Expenses: users can only read/write their own
    match /expenses/{expenseId} {
      allow read, update, delete: if
        request.auth != null &&
        resource.data.userId == request.auth.uid;

      allow create: if
        request.auth != null &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.amount is number &&
        request.resource.data.amount > 0;
    }

    // Recurring Payments: users can only read/write their own
    match /recurringPayments/{recurringId} {
      allow read, update, delete: if
        request.auth != null &&
        resource.data.userId == request.auth.uid;

      allow create: if
        request.auth != null &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.amount is number &&
        request.resource.data.amount > 0 &&
        request.resource.data.frequency in ['weekly', 'monthly', 'yearly'] &&
        request.resource.data.originalDueDay is int &&
        request.resource.data.nextDueDate is timestamp &&
        request.resource.data.reminderDaysBefore is list &&
        request.resource.data.isActive == true;
    }
    
    match /budgets/{budgetId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid
                     && request.resource.data.amount > 0;
      allow update: if request.auth != null && resource.data.userId == request.auth.uid
                     && request.resource.data.amount > 0;
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // Block all other documents
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
